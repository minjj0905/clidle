{
  "name": "clidle",
  "version": "0.1.0",
  "description": "터미널에서 두벌식 로마자 입력으로 한글 자모를 맞히는 CLI 단어 게임",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clidle": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minjj0905/clidle.git"
  },
  "keywords": [
    "cli",
    "game",
    "wordle",
    "korean",
    "hangul",
    "terminal"
  ],
  "author": "kim.minjeong8",
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preprocess": "tsx scripts/preprocess.ts",
    "import-words": "tsx scripts/import-words.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.7"
  }
}
